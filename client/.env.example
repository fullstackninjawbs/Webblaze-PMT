# Vite Frontend Environment Variables
# Note: Variables exposed to Vite client-side code MUST be prefixed with VITE_

# Local Backend API URL
VITE_API_URL=http://localhost:5000/api/v1

# Production Deployment (Vercel):
# In Vercel Project Settings for Frontend, set:
# VITE_API_URL=https://your-backend-api.vercel.app/api/v1
